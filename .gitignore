data/raw/
data/qualitative/

# outputs/ are regenerated by the pipeline and not published, EXCEPT the rendered
# main figures (Figure_1-5), which are committed so readers/reviewers can see them
# without running the code. Everything else under outputs/ stays ignored, including
# the private analysis_long.* and themes/open_questions/.
outputs/*
!outputs/figures/
outputs/figures/*
!outputs/figures/Figure_*.png

*.bak
*.pyc
__pycache__/
.ipynb_checkpoints/
.pytest_cache/
.DS_Store

# Virtual environments (also leak absolute local paths in bin/ shebangs)
.venv/
venv/

# Editor / IDE workspace files
*.code-workspace

# Excel lock / temporary files
~$*.xlsx

# Local environment files
.env

# Unattended-handoff work log (not a research artifact)
HANDOFF-LOG.md

# Generated release report (rebuilt by validate_release.py on every run)
VALIDATION_REPORT.md
# S6 qualitative patterns: participant quotes, deliberately NOT published (see README).
# Built to outputs/ for the authors' own use; this rule also catches any stray copy.
S6_qualitative_patterns*.csv

# Superseded mapping workbooks and README drafts (kept locally, not published)
data/mapping/old/
